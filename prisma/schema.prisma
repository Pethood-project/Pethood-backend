// PETHOOD — schema Prisma
// Fuente conceptual: docs/MODELO_DATOS.md (mantener sincronizados)
//
// Convenciones de este archivo:
// - Nombres Prisma (modelo/campo) en PascalCase/camelCase sin tildes ni ñ (CONSTITUTION.md §5).
// - @map/@@map preservan el nombre de columna documentado en MODELO_DATOS.md, también sin tildes/ñ
//   (transliteración mecánica: reseña->resena, campaña->campania, contraseña->contrasena).
// - Auditoría transversal: {entidad}_usuario_alta/fecha_alta/usuario_modificacion/fecha_modificacion/
//   usuario_baja/fecha_baja en TODA entidad salvo excepción documentada. Son columnas Int/DateTime
//   planas (sin relación Prisma a Usuario) para no explotar el grafo de relaciones — el id "SISTEMA"
//   usado por los cron jobs se siembra como un Usuario real en el seed.
// - Baja siempre lógica (fecha_baja nullable = activo si es null). Nunca DELETE físico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── ENUMS ───────────────
// Selectores de valores fijos, no modelados como catálogo porque no son configurables
// desde el panel admin. Sin tildes ni ñ en los identificadores (CONSTITUTION.md §5) —
// la UI muestra las etiquetas en español correcto.

enum GeneroMascota {
  MACHO
  HEMBRA
}

// Qué es un mensaje del chat (HU-5.2).
//
// TEXTO es todo lo que escribe una persona, con o sin fotos. SOLICITUD es la tarjeta que
// PetHood inserta en la sala cuando se envía una solicitud de adopción o tránsito: la emite
// el usuario SISTEMA y lleva solicitud_id, para que el cliente pinte el estado y la mascota
// sin pedir nada más.
//
// Es un enum de Prisma y no una tabla de catálogo porque son valores del dominio que el
// código ramifica, como GeneroMascota, y no una lista que el administrador edite.
enum TipoMensaje {
  TEXTO
  SOLICITUD

  @@map("tipo_mensaje")
}

enum TamanioMascota {
  PEQUENO
  MEDIANO
  GRANDE
}

// ─────────────── CATÁLOGOS ───────────────
// Todas gestionables desde el panel admin (MODELO_DATOS.md, nota de cierre).

model Especie {
  id          Int     @id @default(autoincrement()) @map("especie_id")
  nombre      String  @unique @map("especie_nombre")
  descripcion String? @map("especie_descripcion")

  usuarioAlta         Int       @map("especie_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("especie_fecha_alta")
  usuarioModificacion Int?      @map("especie_usuario_modificacion")
  fechaModificacion   DateTime? @map("especie_fecha_modificacion")
  usuarioBaja         Int?      @map("especie_usuario_baja")
  fechaBaja           DateTime? @map("especie_fecha_baja")

  razas Raza[]

  @@map("especie")
}

model Raza {
  id        Int    @id @default(autoincrement()) @map("raza_id")
  nombre    String @map("raza_nombre")
  especieId Int    @map("especie_id")

  usuarioAlta         Int       @map("raza_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("raza_fecha_alta")
  usuarioModificacion Int?      @map("raza_usuario_modificacion")
  fechaModificacion   DateTime? @map("raza_fecha_modificacion")
  usuarioBaja         Int?      @map("raza_usuario_baja")
  fechaBaja           DateTime? @map("raza_fecha_baja")

  especie  Especie   @relation(fields: [especieId], references: [id])
  mascotas Mascota[]

  @@unique([nombre, especieId])
  @@map("raza")
}

model EstadoMascota {
  id          Int     @id @default(autoincrement()) @map("estado_mascota_id")
  nombre      String  @unique @map("estado_mascota_nombre")
  descripcion String? @map("estado_mascota_descripcion")

  usuarioAlta         Int       @map("estado_mascota_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_mascota_fecha_alta")
  usuarioModificacion Int?      @map("estado_mascota_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_mascota_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_mascota_usuario_baja")
  fechaBaja           DateTime? @map("estado_mascota_fecha_baja")

  historicos MascotaEstado[]

  @@map("estado_mascota")
}

model EstadoUsuario {
  id          Int     @id @default(autoincrement()) @map("estado_usuario_id")
  nombre      String  @unique @map("estado_usuario_nombre")
  descripcion String? @map("estado_usuario_descripcion")

  usuarioAlta         Int       @map("estado_usuario_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_usuario_fecha_alta")
  usuarioModificacion Int?      @map("estado_usuario_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_usuario_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_usuario_usuario_baja")
  fechaBaja           DateTime? @map("estado_usuario_fecha_baja")

  usuarios Usuario[]

  @@map("estado_usuario")
}

model EstadoRefugio {
  id          Int     @id @default(autoincrement()) @map("estado_refugio_id")
  nombre      String  @unique @map("estado_refugio_nombre")
  descripcion String? @map("estado_refugio_descripcion")

  usuarioAlta         Int       @map("estado_refugio_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_refugio_fecha_alta")
  usuarioModificacion Int?      @map("estado_refugio_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_refugio_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_refugio_usuario_baja")
  fechaBaja           DateTime? @map("estado_refugio_fecha_baja")

  refugios Refugio[]

  @@map("estado_refugio")
}

model EstadoSolicitud {
  id          Int     @id @default(autoincrement()) @map("estado_solicitud_id")
  nombre      String  @unique @map("estado_solicitud_nombre")
  descripcion String? @map("estado_solicitud_descripcion")

  usuarioAlta         Int       @map("estado_solicitud_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_solicitud_fecha_alta")
  usuarioModificacion Int?      @map("estado_solicitud_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_solicitud_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_solicitud_usuario_baja")
  fechaBaja           DateTime? @map("estado_solicitud_fecha_baja")

  historicos SolicitudEstado[]

  @@map("estado_solicitud")
}

model EstadoCampania {
  id          Int     @id @default(autoincrement()) @map("estado_campania_id")
  nombre      String  @unique @map("estado_campania_nombre")
  descripcion String? @map("estado_campania_descripcion")

  usuarioAlta         Int       @map("estado_campania_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_campania_fecha_alta")
  usuarioModificacion Int?      @map("estado_campania_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_campania_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_campania_usuario_baja")
  fechaBaja           DateTime? @map("estado_campania_fecha_baja")

  campanias Campania[]

  @@map("estado_campania")
}

model EstadoAnimalPerdido {
  id          Int     @id @default(autoincrement()) @map("estado_animal_perdido_id")
  nombre      String  @unique @map("estado_animal_perdido_nombre")
  descripcion String? @map("estado_animal_perdido_descripcion")

  usuarioAlta         Int       @map("estado_animal_perdido_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("estado_animal_perdido_fecha_alta")
  usuarioModificacion Int?      @map("estado_animal_perdido_usuario_modificacion")
  fechaModificacion   DateTime? @map("estado_animal_perdido_fecha_modificacion")
  usuarioBaja         Int?      @map("estado_animal_perdido_usuario_baja")
  fechaBaja           DateTime? @map("estado_animal_perdido_fecha_baja")

  reportes AnimalPerdido[]

  @@map("estado_animal_perdido")
}

model TipoSolicitud {
  id            Int     @id @default(autoincrement()) @map("tipo_solicitud_id")
  nombre        String  @unique @map("tipo_solicitud_nombre")
  descripcion   String? @map("tipo_solicitud_descripcion")
  secuenciaDias Int     @map("tipo_solicitud_secuencia_dias")

  usuarioAlta         Int       @map("tipo_solicitud_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("tipo_solicitud_fecha_alta")
  usuarioModificacion Int?      @map("tipo_solicitud_usuario_modificacion")
  fechaModificacion   DateTime? @map("tipo_solicitud_fecha_modificacion")
  usuarioBaja         Int?      @map("tipo_solicitud_usuario_baja")
  fechaBaja           DateTime? @map("tipo_solicitud_fecha_baja")

  solicitudes Solicitud[]

  @@map("tipo_solicitud")
}

model Rol {
  id          Int     @id @default(autoincrement()) @map("rol_id")
  nombre      String  @unique @map("rol_nombre")
  descripcion String? @map("rol_descripcion")

  usuarioAlta         Int       @map("rol_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("rol_fecha_alta")
  usuarioModificacion Int?      @map("rol_usuario_modificacion")
  fechaModificacion   DateTime? @map("rol_fecha_modificacion")
  usuarioBaja         Int?      @map("rol_usuario_baja")
  fechaBaja           DateTime? @map("rol_fecha_baja")

  usuarios RolUsuario[]

  @@map("rol")
}

// ─────────────── USUARIOS ───────────────

model Usuario {
  id               Int       @id @default(autoincrement()) @map("usuario_id")
  nombre           String    @map("usuario_nombre")
  apellido         String    @map("usuario_apellido")
  email            String    @unique @map("usuario_email")
  // Nullable: las cuentas creadas solo con Google no tienen contraseña local.
  contrasena       String?   @map("usuario_contrasena")
  telefono         String?   @map("usuario_telefono")
  // Nullable: el registro mobile actual no pide DNI; Google OAuth tampoco.
  dni              String?   @unique @map("usuario_dni")
  fechaNacimiento  DateTime? @map("usuario_fecha_nacimiento")
  googleId         String?   @unique @map("usuario_google_id")
  verificado       Boolean   @default(false) @map("usuario_verificado")
  imagenUrl        String?   @map("usuario_imagen_url")
  // Barrio / ciudad del perfil (GUI-15). Nullable para cuentas nuevas o de Google.
  ubicacion        String?   @map("usuario_ubicacion")
  refugioId        Int?      @map("refugio_id")
  estadoId         Int       @map("estado_id")

  usuarioAlta         Int       @map("usuario_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("usuario_fecha_alta")
  usuarioModificacion Int?      @map("usuario_usuario_modificacion")
  fechaModificacion   DateTime? @map("usuario_fecha_modificacion")
  usuarioBaja         Int?      @map("usuario_usuario_baja")
  fechaBaja           DateTime? @map("usuario_fecha_baja")

  refugio Refugio?      @relation(fields: [refugioId], references: [id])
  estado  EstadoUsuario @relation(fields: [estadoId], references: [id])

  roles                RolUsuario[]
  mascotas             Mascota[]
  publicaciones        Publicacion[]
  favoritos            Favorito[]
  solicitudes          Solicitud[]
  resenasComoAutor     Resena[]        @relation("ResenaAutor")
  resenasComoReportado Resena[]        @relation("ResenaReportado")
  chats                UsuarioChat[]
  mensajes             Mensaje[]
  notificaciones       Notificacion[]
  hogares              Hogar[]
  donaciones           Donacion[]
  reportesPerdido      AnimalPerdido[]

  @@map("usuario")
}

model RolUsuario {
  id        Int @id @default(autoincrement()) @map("rol_usuario_id")
  usuarioId Int @map("usuario_id")
  rolId     Int @map("rol_id")

  usuarioAlta         Int       @map("rol_usuario_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("rol_usuario_fecha_alta")
  usuarioModificacion Int?      @map("rol_usuario_usuario_modificacion")
  fechaModificacion   DateTime? @map("rol_usuario_fecha_modificacion")
  usuarioBaja         Int?      @map("rol_usuario_usuario_baja")
  fechaBaja           DateTime? @map("rol_usuario_fecha_baja")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  rol     Rol     @relation(fields: [rolId], references: [id])

  @@index([usuarioId, rolId])
  @@map("rol_usuario")
}

// ─────────────── REFUGIOS ───────────────

model Refugio {
  id          Int     @id @default(autoincrement()) @map("refugio_id")
  nombre      String  @map("refugio_nombre")
  direccion   String  @map("refugio_direccion")
  telefono    String? @map("refugio_telefono")
  email       String? @map("refugio_email")
  descripcion String? @map("refugio_descripcion")
  verificado  Boolean @default(false) @map("refugio_verificado")
  imagenUrl   String? @map("refugio_imagen_url")
  estadoId    Int     @map("estado_id")

  usuarioAlta         Int       @map("refugio_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("refugio_fecha_alta")
  usuarioModificacion Int?      @map("refugio_usuario_modificacion")
  fechaModificacion   DateTime? @map("refugio_fecha_modificacion")
  usuarioBaja         Int?      @map("refugio_usuario_baja")
  fechaBaja           DateTime? @map("refugio_fecha_baja")

  estado EstadoRefugio @relation(fields: [estadoId], references: [id])

  usuarios             Usuario[]
  mascotas             Mascota[]
  campanias            Campania[]
  resenasComoReportado Resena[]   @relation("ResenaReportado")
  chats                Chat[]

  @@map("refugio")
}

// ─────────────── MASCOTAS ───────────────

// `peso` y `tamanio` no vienen del diagrama de clases original — se agregaron porque el
// formulario de alta los pide. Ver MODELO_DATOS.md.
//
// Nullables en base igual que `nombre` y `fechaNacimiento`: la obligatoriedad se impone en
// mascotas.dto.ts, no en la columna, para no bloquear altas desde otros flujos (ej. un
// animal encontrado del que no se conocen todos los datos).
model Mascota {
  id              Int             @id @default(autoincrement()) @map("mascota_id")
  nombre          String?         @map("mascota_nombre")
  fechaNacimiento DateTime?       @map("mascota_fecha_nacimiento")
  genero          GeneroMascota   @map("mascota_genero")
  peso            Decimal?        @map("mascota_peso") @db.Decimal(4, 1)
  tamanio         TamanioMascota? @map("mascota_tamanio")
  castrado        Boolean         @default(false) @map("mascota_castrado")
  descripcion     String?         @map("mascota_descripcion")
  imagenUrl       String?         @map("mascota_imagen_url")
  razaId          Int             @map("raza_id")
  refugioId       Int?            @map("refugio_id")
  usuarioId       Int             @map("usuario_id")

  usuarioAlta         Int       @map("mascota_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("mascota_fecha_alta")
  usuarioModificacion Int?      @map("mascota_usuario_modificacion")
  fechaModificacion   DateTime? @map("mascota_fecha_modificacion")
  usuarioBaja         Int?      @map("mascota_usuario_baja")
  fechaBaja           DateTime? @map("mascota_fecha_baja")

  raza    Raza     @relation(fields: [razaId], references: [id])
  refugio Refugio? @relation(fields: [refugioId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  historicoEstados MascotaEstado[]
  publicaciones    Publicacion[]
  favoritos        Favorito[]
  historiaClinica  HistoriaClinica[]
  reportesPerdido  AnimalPerdido[]

  @@map("mascota")
}

// Histórico N:1 de estados de una mascota — sin par de modificación propio
// (MODELO_DATOS.md: "auditoría alta/baja, sin campo de modificación propio distinto del genérico").
model MascotaEstado {
  id              Int @id @default(autoincrement()) @map("mascota_estado_id")
  mascotaId       Int @map("mascota_id")
  estadoMascotaId Int @map("estado_mascota_id")

  usuarioAlta Int       @map("mascota_estado_usuario_alta")
  fechaAlta   DateTime  @default(now()) @map("mascota_estado_fecha_alta")
  usuarioBaja Int?      @map("mascota_estado_usuario_baja")
  fechaBaja   DateTime? @map("mascota_estado_fecha_baja")

  mascota       Mascota       @relation(fields: [mascotaId], references: [id])
  estadoMascota EstadoMascota @relation(fields: [estadoMascotaId], references: [id])

  @@map("mascota_estado")
}

// ─────────────── PUBLICACIONES ───────────────

// Varios campos de acá no están en el diagrama de clases (ver MODELO_DATOS.md). Los text[]
// se usan para listas de valores simples, sin atributos ni ciclo de vida propio, donde no
// se justifica una tabla hija.
//
// `imagenes` guarda hasta 5 fotos y el orden del array ES el orden de la galería: la
// primera es la portada. `imagenUrl` se mantiene con esa portada, para no romper lo que ya
// lee ese campo.
model Publicacion {
  id            Int      @id @default(autoincrement()) @map("publicacion_id")
  titulo        String   @map("publicacion_titulo")
  descripcion   String?  @map("publicacion_descripcion")
  ubicacion     String?  @map("publicacion_ubicacion")
  requisitos    String[] @map("publicacion_requisitos")
  personalidad  String[] @map("publicacion_personalidad")
  desparasitado Boolean  @default(false) @map("publicacion_desparasitado")
  vacunas       String?  @map("publicacion_vacunas")
  imagenes      String[] @map("publicacion_imagenes")
  imagenUrl     String?  @map("publicacion_imagen_url")
  mascotaId     Int      @map("mascota_id")
  usuarioId     Int      @map("usuario_id")

  usuarioAlta         Int       @map("publicacion_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("publicacion_fecha_alta")
  usuarioModificacion Int?      @map("publicacion_usuario_modificacion")
  fechaModificacion   DateTime? @map("publicacion_fecha_modificacion")
  usuarioBaja         Int?      @map("publicacion_usuario_baja")
  fechaBaja           DateTime? @map("publicacion_fecha_baja")

  mascota Mascota @relation(fields: [mascotaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  solicitudes Solicitud[]

  @@map("publicacion")
}

// Además del índice de abajo, la tabla tiene dos índices PARCIALES que Prisma no sabe
// expresar y viven en `migrations/20260820120000_favorito_indices_parciales`:
//
// - `favorito_usuario_mascota_activo_uq` — único (usuario, mascota) WHERE fecha_baja IS NULL.
//   Garantiza un solo favorito activo por par sin impedir volver a guardar algo que se quitó.
// - `favorito_usuario_fecha_alta_idx` — (usuario, fecha_alta DESC) WHERE fecha_baja IS NULL,
//   para el orden por defecto de HU-6.6.
//
// Quitar un favorito es baja lógica (regla 1 de CLAUDE.md): cada ciclo de guardar/quitar
// deja su propia fila, así que el par (usuario, mascota) puede repetirse en el histórico.
model Favorito {
  id        Int @id @default(autoincrement()) @map("favorito_id")
  usuarioId Int @map("usuario_id")
  mascotaId Int @map("mascota_id")

  usuarioAlta         Int       @map("favorito_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("favorito_fecha_alta")
  usuarioModificacion Int?      @map("favorito_usuario_modificacion")
  fechaModificacion   DateTime? @map("favorito_fecha_modificacion")
  usuarioBaja         Int?      @map("favorito_usuario_baja")
  fechaBaja           DateTime? @map("favorito_fecha_baja")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  mascota Mascota @relation(fields: [mascotaId], references: [id])

  @@index([usuarioId, mascotaId])
  @@map("favorito")
}

// ─────────────── ADOPCIÓN ───────────────

model Solicitud {
  id             Int       @id @default(autoincrement()) @map("solicitud_id")
  motivacion     String    @map("solicitud_motivacion")
  fechaRespuesta DateTime? @map("solicitud_fecha_respuesta")
  comentario     String?   @map("solicitud_comentario")

  // Período ofrecido cuando el tipo es "Transito". Nulos en una solicitud de adopción:
  // no hay período que declarar. Van en Solicitud y no en Hogar porque son de ESTA
  // solicitud — el hogar es el perfil del usuario y lo comparten todas.
  fechaInicioTransito DateTime? @map("solicitud_fecha_inicio_transito")
  fechaFinTransito    DateTime? @map("solicitud_fecha_fin_transito")

  publicacionId   Int @map("publicacion_id")
  usuarioId       Int @map("usuario_id")
  tipoSolicitudId Int @map("tipo_solicitud_id")

  // Versión del hogar que estaba vigente al enviar: es lo que el refugio evaluó. El hogar
  // del usuario se versiona (baja lógica + alta, igual que HistoriaClinica), así una
  // mudanza posterior no reescribe lo que se declaró. Nullable: las solicitudes anteriores
  // a HU-7.1 no tienen hogar.
  hogarId Int? @map("hogar_id")

  usuarioAlta         Int       @map("solicitud_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("solicitud_fecha_alta")
  usuarioModificacion Int?      @map("solicitud_usuario_modificacion")
  fechaModificacion   DateTime? @map("solicitud_fecha_modificacion")
  usuarioBaja         Int?      @map("solicitud_usuario_baja")
  fechaBaja           DateTime? @map("solicitud_fecha_baja")

  publicacion   Publicacion   @relation(fields: [publicacionId], references: [id])
  usuario       Usuario       @relation(fields: [usuarioId], references: [id])
  tipoSolicitud TipoSolicitud @relation(fields: [tipoSolicitudId], references: [id])
  hogar         Hogar?        @relation(fields: [hogarId], references: [id])

  historicoEstados SolicitudEstado[]
  seguimientos     Seguimiento[]
  chats            Chat[]
  mensajes         Mensaje[]

  @@map("solicitud")
}

model SolicitudEstado {
  id                Int @id @default(autoincrement()) @map("solicitud_estado_id")
  solicitudId       Int @map("solicitud_id")
  estadoSolicitudId Int @map("estado_solicitud_id")

  usuarioAlta         Int       @map("solicitud_estado_usuario_alta")
