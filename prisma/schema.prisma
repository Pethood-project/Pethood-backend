// ─────────────── CHAT ───────────────
// Chat: "alta y baja" explícito en la nota de Mensaje (cita textual del doc de requisitos)
// — sin par de modificación propio, igual que Mascota_Estado.
//
// `refugioId` NO reemplaza a UsuarioChat, lo complementa (HU-5.1, docs/api-chats.md):
// UsuarioChat es la única tabla de pertenencia — toda persona con acceso a la sala tiene
// fila, incluido el miembro del refugio que atiende. `refugioId` es una etiqueta
// institucional: dice que la contraparte de la conversación es ese refugio, y es lo que
// define qué nombre e imagen ve el adoptante. Tiene que ser así porque Mensaje.usuarioId
// es NOT NULL contra Usuario: un refugio no emite mensajes, los emite una persona.
//
// Corolario: `refugioId != null` ⇔ chat adoptante↔refugio; `null` ⇔ coordinación entre
// adoptantes por una mascota perdida (REQUISITOS.md, módulo 5). Son los dos casos que
// `tipo` querría distinguir, ya derivables sin él.

model Chat {
  id        Int     @id @default(autoincrement()) @map("chat_id")
  tipo      String? @map("chat_tipo") // valores sin confirmar — ver nota en MODELO_DATOS.md
  refugioId Int?    @map("refugio_id")

  // Solicitud que habilitó la sala (CONSTITUTION §7: no hay chat sin interacción previa).
  // Nullable: las salas de coordinación por mascota perdida (HU-13.2) y las anteriores a
  // esta HU no salen de una solicitud.
  solicitudId Int? @map("solicitud_id")

  usuarioAlta Int       @map("chat_usuario_alta")
  fechaAlta   DateTime  @default(now()) @map("chat_fecha_alta")
  usuarioBaja Int?      @map("chat_usuario_baja")
  fechaBaja   DateTime? @map("chat_fecha_baja")

  refugio   Refugio?   @relation(fields: [refugioId], references: [id])
  solicitud Solicitud? @relation(fields: [solicitudId], references: [id])

  participantes UsuarioChat[]
  mensajes      Mensaje[]

  @@map("chat")
}

// Además del índice de abajo, la tabla tiene un índice PARCIAL que Prisma no sabe expresar
// y vive en `migrations/20260901120000_chat_indices_listado_conversaciones`:
//
// - `usuario_chat_usuario_activo_idx` — (usuario_id) WHERE fecha_baja IS NULL. Es el punto
//   de entrada de HU-5.1 ("mis salas activas"); el índice de abajo arranca por `chat_id` y
//   no sirve para buscar por usuario.
model UsuarioChat {
  id        Int @id @default(autoincrement()) @map("usuario_chat_id")
  chatId    Int @map("chat_id")
  usuarioId Int @map("usuario_id")

  // Hasta qué momento este participante tiene la sala leída y entregada. Un mensaje ajeno
  // cuenta como no leído si su `mensaje_fecha_alta` es posterior a `ultima_lectura`.
  //
  // Van acá y no en `Mensaje` porque el estado es POR PARTICIPANTE: `mensaje_leido` es un
  // booleano único por mensaje, sin dueño, y con tres o más personas en la sala el primero
  // que abre le baja el badge al resto. Además es una sola escritura por sala abierta en
  // lugar de un UPDATE masivo sobre `mensaje`. Nullable: nunca leyó ni recibió nada.
  ultimaLectura DateTime? @map("usuario_chat_ultima_lectura")
  ultimaEntrega DateTime? @map("usuario_chat_ultima_entrega")

  usuarioAlta         Int       @map("usuario_chat_usuario_alta")
  fechaAlta           DateTime  @default(now()) @map("usuario_chat_fecha_alta")
  usuarioModificacion Int?      @map("usuario_chat_usuario_modificacion")
  fechaModificacion   DateTime? @map("usuario_chat_fecha_modificacion")
  usuarioBaja         Int?      @map("usuario_chat_usuario_baja")
  fechaBaja           DateTime? @map("usuario_chat_fecha_baja")

  chat    Chat    @relation(fields: [chatId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([chatId, usuarioId])
  @@map("usuario_chat")
}

// Mensaje: solo alta, nunca baja ni modificación (MODELO_DATOS.md, excepción explícita).
//
// La tabla no declara índices acá pero tiene dos en
// `migrations/20260901120000_chat_indices_listado_conversaciones`:
//
// - `mensaje_chat_fecha_alta_idx` — (chat_id, fecha_alta DESC). Sostiene el DISTINCT ON que
//   trae el último mensaje de todos los chats de un usuario en una sola query (HU-5.1) y el
//   historial paginado de la sala (HU-5.2). No es parcial: no hay `fecha_baja` que filtrar.
// - `mensaje_chat_usuario_no_leido_idx` — (chat_id, usuario_id) WHERE leido = false, para el
//   contador de no leídos. Parcial porque las filas no leídas son una minoría que se achica
//   sola a medida que se abren las salas.
//
// `leido` es un booleano ÚNICO por mensaje, no por participante: alcanza para una sala de
// dos (los no leídos de alguien son los mensajes que no emitió él), pero NO soportaría un
// chat grupal. Ver "Pendientes" en docs/api-chats.md.
model Mensaje {
  id        Int    @id @default(autoincrement()) @map("mensaje_id")
  contenido String @map("mensaje_contenido")

  // OBSOLETO desde HU-5.2 (brechas de chat): lo reemplazan usuario_chat_ultima_lectura y
  // usuario_chat_ultima_entrega, que son POR PARTICIPANTE. Se mantiene poblado para no
  // romper lecturas viejas, pero nada del código lo consulta.
  leido Boolean @default(false) @map("mensaje_leido")

  // Primera imagen del mensaje, desnormalizada: la usa el preview del listado (HU-5.1) sin
  // tener que mirar el array. Mismo par que `publicacion_imagen_url` / `publicacion_imagenes`.
  imagenUrl String?  @map("mensaje_imagen_url")
  imagenes  String[] @map("mensaje_imagenes")

  tipo TipoMensaje @default(TEXTO) @map("mensaje_tipo")

  // Sólo en los mensajes de tipo SOLICITUD: la tarjeta que se pinta en la sala.
  solicitudId Int? @map("solicitud_id")

  chatId    Int @map("chat_id")
  usuarioId Int @map("usuario_id")

  usuarioAlta Int      @map("mensaje_usuario_alta")
  fechaAlta   DateTime @default(now()) @map("mensaje_fecha_alta")

  chat      Chat       @relation(fields: [chatId], references: [id])
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  solicitud Solicitud? @relation(fields: [solicitudId], references: [id])

  // Conteo de no leídos con el modelo nuevo: "mensajes de la sala que no emití yo y son
  // posteriores a mi última lectura". Los índices parciales de HU-5.1 siguen en SQL a mano.
  @@index([chatId, usuarioId, fechaAlta])
  @@map("mensaje")
}

