# Copiar a .env y completar. NUNCA commitear .env
DATABASE_URL="postgresql://pethood:pethood@localhost:5432/pethood?schema=public"
# En Neon: DATABASE_URL es la URL pooled (host con -pooler, + &pgbouncer=true) y DIRECT_URL la directa.
# En local, las dos iguales.
DIRECT_URL="postgresql://pethood:pethood@localhost:5432/pethood?schema=public"
PORT=3000
# Saltos de proxy delante del server (0 = ninguno). Necesario para el rate limit por IP tras un proxy.
TRUST_PROXY=0
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# Google OAuth 2.0 (opcional: sin estas keys, /auth/google responde 503)
# Crear credenciales en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Client ID de tipo Android (opcional): sin él, el login con Google del APK responde 401.
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# URL del panel web-admin (Next). Usar un puerto distinto al de esta API.
FRONTEND_WEB_URL="http://localhost:3001"

# Cloudflare R2. false = el registro ignora la foto y no usa R2.
# true = sube la foto y guarda solo la URL pública en usuario_imagen_url.
# Crear un bucket + API token S3 en https://dash.cloudflare.com → R2
R2_ENABLED="false"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

# Geocodificación de direcciones (node-geocoder) para perfil de usuario y refugio.
# "openstreetmap" (gratis, sin key) o "google" (exige GEOCODER_API_KEY).
GEOCODER_PROVIDER="openstreetmap"
GEOCODER_API_KEY=""
# Contacto para Nominatim (OpenStreetMap). Opcional pero recomendado.
GEOCODER_EMAIL=""
